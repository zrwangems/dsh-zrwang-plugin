{
  "name": "dsh-zrwang-plugin",
  "version": "0.0.3",
  "type": "module",
  "description": "王湛然的 DSH 管理插件：DSH Desktop 右侧栏技能管理，按会话启用技能。",
  "main": "./host/index.mjs",
  "exports": {
    ".": "./host/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host",
    "client",
    "lib",
    "catalog",
    "config",
    "skills",
    "vendor",
    "scripts",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "icon.png"
  ],
  "scripts": {
    "vendor": "node scripts/vendor-skills.mjs",
    "catalog": "node scripts/gen-catalog.mjs",
    "build": "node scripts/build-client.mjs",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke-host.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bundle",
    "skills",
    "better-sidebar"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "author": "Zhanran Wang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zrwangems/dsh-zrwang-plugin.git"
  },
  "homepage": "https://github.com/zrwangems/dsh-zrwang-plugin#readme",
  "bugs": {
    "url": "https://github.com/zrwangems/dsh-zrwang-plugin/issues"
  },
  "dependencies": {
    "dsh-better-sidebar": "^0.28.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
