    {
      "id": "ars",
      "repo": "Imbad0202/academic-research-skills",
      "ref": "main",
      "layout": "skill-dirs",
      "names": [
        "deep-research",
        "academic-paper",
        "academic-paper-reviewer",
        "academic-pipeline",
        "sr-screener"
      ],
      "target": "ars/skills",
      "label": "Academic Research Skills (ARS)",
      "download": "git",
      "note": "上游把 shared/ 与 scripts/ 放在仓库根、技能正文按仓库根相对路径引用；DSH 技能资源根就是技能目录本身，所以每个技能内补 _shared/ 与 _scripts/ 并改写引用。",
      "extraDirs": [
        {
          "from": "shared",
          "to": "_shared"
        }
      ],
      "sharedFiles": [
        {
          "from": "MODE_REGISTRY.md",
          "to": "_shared/MODE_REGISTRY.md"
        },
        {
          "from": "docs/ARCHITECTURE.md",
          "to": "_shared/ARCHITECTURE.md"
        }
      ],
      "scriptClosure": {
        "from": "scripts",
        "into": "scripts",
        "maxBytes": 20000000
      },
      "runtimeRoot": "ars",
      "outsideCatalog": true,
      "descriptions": "vendor/ars/descriptions.json",
      "rewrite": [
        {
          "find": "shared/",
          "to": "_shared/"
        },
        {
          "find": "deep-research/",
          "to": "../deep-research/",
          "optional": true
        },
        {
          "find": "academic-paper/",
          "to": "../academic-paper/",
          "optional": true
        },
        {
          "find": "academic-paper-reviewer/",
          "to": "../academic-paper-reviewer/",
          "optional": true
        },
        {
          "find": "academic-pipeline/",
          "to": "../academic-pipeline/",
          "optional": true
        },
        {
          "find": "sr-screener/",
          "to": "../sr-screener/",
          "optional": true
        },
        {
          "find": "python3 ",
          "to": "python ",
          "optional": true
        },
        {
          "find": "AskUserQuestion",
          "to": "ask_user_question",
          "optional": true
        },
        {
          "find": "WebSearch",
          "to": "web_search",
          "optional": true
        },
        {
          "find": "WebFetch",
          "to": "web_fetch",
          "optional": true
        },
        {
          "find": "Skill tool",
          "to": "skill 工具",
          "optional": true
        },
        {
          "find": "Task tool",
          "to": "subagent 工具",
          "optional": true
        },
        {
          "find": "Traditional Chinese",
          "to": "Simplified Chinese"
        },
        {
          "find": "繁體中文",
          "to": "简体中文",
          "optional": true
        },
        {
          "find": "zh-TW-only",
          "to": "Chinese-only",
          "optional": true
        },
        {
          "find": "EN / zh-TW / bilingual",
          "to": "EN / Chinese / bilingual",
          "optional": true
        },
        {
          "find": "default zh-TW + EN",
          "to": "default Chinese + EN",
          "optional": true
        },
        {
          "find": "Chinese Abstract (zh-TW)",
          "to": "Chinese Abstract (中文)",
          "optional": true
        }
      ],
      "headerNote": {
        "files": "(?:^|/)(?:SKILL\\.md|agents/[^/]+\\.md|references/[^/]+\\.md)$",
        "text": "> 输出语言（本 DSH 集成强制）：所有面向用户的文字、稿件、摘要、评审与报告一律使用**简体中文**；英文术语与引文保持英文。文中的 `zh-TW` / `zh-tw-en` 只是上游语言代码与脚本参数，不代表要用繁体输出。用户明确要求其他语言时以用户为准。\n>\n> 多角色执行（评审团、十阶段流水线、角色扮演）必须使用 DSH 的 Agent Team 工具（`spawn_teammate`、`team_task_*`、`wait_agent`、`send_message`）；当前会话看不到这些工具，说明用户没开 Agent Team，必须先提示用户开启，不得退化成单会话顺序扮演。"
      },
      "aliases": {
        "from": "commands",
        "target": "ars/commands",
        "rewrite": [
          {
            "find": "academic-research-skills:",
            "to": ""
          },
          {
            "find": "Skill tool",
            "to": "skill 工具"
          }
        ]
      }
    },
